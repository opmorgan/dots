set recolor-keephue 1
set pages-per-row 1
set page-padding 0
set selection-clipboard "clipboard"
set guioptions "s"
set statusbar-basename 1
set window-title-basename  true
set window-title-home-tilde 1
set window-height 1080
set window-width 835
map b toggle_statusbar
map f display_link

set default-bg "#100e0d"
set default-fg "#d7d6d6"
set statusbar-fg "#d7d6d6"
set statusbar-bg "#100e0d"
set highlight-color "#7D8081"
set highlight-active-color "#92918F"
set recolor-lightcolor "#d7d6d6"
set recolor-darkcolor "#100e0d"
set recolor "false"
set page-padding "25"
set inputbar-fg "#d7d6d6"
set inputbar-bg "#100e0d"
set notification-fg "#d7d6d6"
set notification-bg "#100e0d"
